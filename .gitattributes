# ─────────────────────────────────────────────────────────────────────────────
# 换行符统一策略（2026-09-23 收敛）
#
# 背景：仓库历史 blob 为 CRLF（Windows 开发树提交），Linux 侧工作区为 LF，
# 导致全仓每个文件都显示「被修改」，真实改动被淹没（曾虚高到 44k 行）。
# 本文件一次性锁定：仓库内一律 LF，检出到工作区（含 Windows）也一律 LF。
#
# ⚠️ 只影响**此后**的 add/checkout；已有 blob 需 `git add --renormalize .` 收敛。
# ─────────────────────────────────────────────────────────────────────────────

# 默认：自动识别文本文件，仓库与工作区统一 LF
* text=auto eol=lf

# 显式声明二进制，避免被 text=auto 误判后转换损坏
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bmp   binary
*.webp  binary
*.ico   binary
*.tif   binary
*.tiff  binary
*.mp4   binary
*.mov   binary
*.avi   binary
*.mkv   binary
*.webm  binary
*.m4a   binary
*.aac   binary
*.mp3   binary
*.wav   binary
*.flac  binary
*.pt    binary
*.pth   binary
*.onnx  binary
*.engine binary
*.trt   binary
*.so    binary
*.dll   binary
*.dylib binary
*.exe   binary
*.bin   binary
*.mdb   binary
*.core  binary
*.zip   binary
*.gz    binary
*.7z    binary
*.pdf   binary

# 无扩展名的二进制测试夹具（git 自动识别为 binary，显式兜底）
tests/test_nvenc_struct_dump binary
